# Database — SQLite for local dev; Railway auto-sets this to PostgreSQL
DATABASE_URL=sqlite:///./flashcards.db

# Auth — generate a strong key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# First-run admin account (used by scripts/seed_user.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# App behaviour
DATA_DIR=./data/languages
TYPING_FUZZY_THRESHOLD=0.85
DEFAULT_QUIZ_CARD_COUNT=20
BIG_TEST_CARD_OPTIONS=10,20,50,100
MAX_UPLOAD_SIZE_MB=5
MAX_UPLOAD_SIZE_APKG_MB=200
HINT_MAX_PRESSES=3

# AI / TTS integrations (leave blank to disable)
ANTHROPIC_API_KEY=
GOOGLE_TTS_API_KEY=

# PWA push notifications — run scripts/gen_vapid_keys.py once to generate
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:your@email.com
